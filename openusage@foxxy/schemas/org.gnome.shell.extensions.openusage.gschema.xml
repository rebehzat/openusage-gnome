<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.openusage" path="/org/gnome/shell/extensions/openusage/">
    <key name="refresh-interval" type="u">
      <default>300</default>
      <summary>Refresh interval (seconds)</summary>
    </key>
    <key name="show-label" type="b">
      <default>true</default>
      <summary>Show percentage label in panel</summary>
    </key>
    <key name="warn-threshold" type="i">
      <default>80</default>
      <summary>Warning threshold (%)</summary>
    </key>
    <key name="show-codex" type="b">
      <default>true</default>
      <summary>Track pi OpenAI Codex</summary>
    </key>
    <key name="show-opencode" type="b">
      <default>true</default>
      <summary>Track pi OpenCode Go</summary>
    </key>
    <key name="chatgpt-base-url" type="s">
      <default>""</default>
      <summary>Optional ChatGPT backend base URL override</summary>
    </key>
  </schema>
</schemalist>
